[Unit]
Description=sout - s-ui 动态家宽出口插件 (VPN Gate)
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
# 端口由 /var/lib/sout/settings.json 决定（界面和 f 菜单都改它）。
# 这里不写 -web，否则改完端口一重启就被拽回旧值。
ExecStart=/usr/local/bin/sout-server -dir /var/lib/sout
Restart=always
RestartSec=3
LimitNOFILE=65536
# 退出时给足时间优雅关闭活跃连接与隧道
TimeoutStopSec=30
KillMode=mixed

[Install]
WantedBy=multi-user.target
